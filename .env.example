# Copy to .env and fill in. NEVER commit .env (CLAUDE.md §8).

NODE_ENV=development

# --- Server ---
PORT=3000
# Comma-separated list. CORS is locked to exactly these (CLAUDE.md §8).
CORS_ORIGINS=http://localhost:5173

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL=postgres://tillhaven:tillhaven@localhost:5432/tillhaven

# The test suite TRUNCATES every table between tests, so it uses its own
# database. Leave this unset and it derives one by appending "_test" to the
# name above; the suite creates and migrates it, and refuses to run against any
# database whose name does not end in "_test".
# TEST_DATABASE_URL=postgres://tillhaven:tillhaven@localhost:5432/tillhaven_test

# --- Redis (sessions, rate limiting, short-lived locks) ---
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-bytes-of-hex
# Set to true only behind HTTPS.
COOKIE_SECURE=false

# --- Stripe (Phase 5 only; leave blank until then) ---
# One-time payment mode. NOT a subscription (CLAUDE.md §7).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_VIP_PRICE_ID=
